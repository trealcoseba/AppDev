@page "/staff"
@inject QueueService QueueService
@implements IDisposable

<div class="container page-body">
    <div class="page-heading-row">
        <div class="page-heading">
            <div class="heading-icon">🎧</div>
            <div>
                <h2>Staff Queue Management</h2>
                <p class="text-muted">Manage and serve student tickets in real-time.</p>
            </div>
        </div>

        <div class="staff-controls-top">
            <label class="dept-filter-label">Filter Department:</label>
            <select class="form-control filter-select" @bind="selectedDept">
                <option value="All">All Departments</option>
                <option value="Registrar Office">Registrar Office</option>
                <option value="Finance and Accounting Office">Finance Office</option>
                <option value="Enrollment Technical Office">Enrollment Technical Office</option>
            </select>
            <button class="btn btn-outline btn-sm" @onclick="QueueService.SeedInitialData">
                ↻ Reset Demo Data
            </button>
        </div>
    </div>

    <!-- Stat Metrics Row -->
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-info">
                <div class="metric-label">Waiting</div>
                <div class="metric-value">@WaitingCount</div>
            </div>
            <div class="metric-icon icon-orange">👥</div>
        </div>

        <div class="metric-card">
            <div class="metric-info">
                <div class="metric-label">Now Serving</div>
                <div class="metric-value">@ServingCount</div>
            </div>
            <div class="metric-icon icon-gold">🔔</div>
        </div>

        <div class="metric-card">
            <div class="metric-info">
                <div class="metric-label">Completed</div>
                <div class="metric-value">@CompletedCount</div>
            </div>
            <div class="metric-icon icon-green">✔</div>
        </div>

        <div class="metric-card">
            <div class="metric-info">
                <div class="metric-label">Skipped</div>
                <div class="metric-value">@SkippedCount</div>
            </div>
            <div class="metric-icon icon-blue">⏭</div>
        </div>
    </div>

    <div class="staff-workspace-grid">
        <!-- Now Serving Card -->
        <div class="workspace-col">
            <h4 class="section-title">CURRENTLY SERVING</h4>

            @if (CurrentServing != null)
            {
                <div class="serving-card">
                    <div class="serving-header">
                        <div>
                            <h3 class="ticket-code">@CurrentServing.TicketNumber</h3>
                            <div class="dept-text">@CurrentServing.Department</div>
                        </div>
                        <span class="badge-pill green-pill pulse">Active Session</span>
                    </div>

                    <div class="details-grid">
                        <div class="detail-row">
                            <span class="label">Student Name</span>
                            <span class="val">@CurrentServing.StudentName</span>
                        </div>
                        <div class="detail-row">
                            <span class="label">Student ID</span>
                            <span class="val">@CurrentServing.StudentId</span>
                        </div>
                        <div class="detail-row">
                            <span class="label">Service</span>
                            <span class="val">@CurrentServing.Service</span>
                        </div>
                        <div class="detail-row">
                            <span class="label">Counter / Teller</span>
                            <span class="val">@(string.IsNullOrEmpty(CurrentServing.Teller) ? "Counter 1" : CurrentServing.Teller)</span>
                        </div>
                    </div>

                    <div class="action-buttons-group">
                        <button class="btn btn-complete" @onclick="() => QueueService.CompleteServingTicket(CurrentServing.TicketNumber)">
                            ✔ Mark Complete
                        </button>
                        <button class="btn btn-skip" @onclick="() => QueueService.SkipTicket(CurrentServing.TicketNumber)">
                            ⏭ Skip
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="serving-card empty-serving">
                    <div class="empty-icon">☕</div>
                    <h4>No Student Currently at Counter</h4>
                    <p class="text-muted">Select a department above or call the next student in queue.</p>
                    @if (WaitingCount > 0)
                    {
                        var targetDept = selectedDept == "All" ? "Registrar Office" : selectedDept;
                        <button class="btn btn-primary" @onclick='() => QueueService.CallNext(targetDept, "Window 1")'>
                            📢 Call Next Student (@targetDept)
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Live Waiting Line -->
        <div class="workspace-col">
            <h4 class="section-title">
                UPCOMING IN LINE 
                <span class="badge-count">@FilteredWaitingTickets.Count</span>
            </h4>

            <div class="waiting-line-list">
                @if (FilteredWaitingTickets.Any())
                {
                    @foreach (var ticket in FilteredWaitingTickets)
                    {
                        <div class="waiting-item-card">
                            <div class="ticket-col">
                                <span class="badge-ticket">@ticket.TicketNumber</span>
                                <span class="ticket-time">@ticket.CreatedAt.ToString("h:mm tt")</span>
                            </div>
                            <div class="student-col">
                                <strong>@ticket.StudentName</strong>
                                <span class="sub-service">@ticket.Service • @ticket.Department</span>
                            </div>
                            <div class="action-col">
                                <button class="btn btn-sm btn-outline" @onclick='() => QueueService.CallNext(ticket.Department, "Counter 1")'>
                                    Call Now
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-waiting">
                        No students waiting in this category. Students can join at the <strong>/student</strong> screen.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string selectedDept = "All";
    private bool _isDisposed = false;

    private IEnumerable<QueueTicket> ActiveTickets =>
        selectedDept == "All" 
            ? QueueService.Tickets 
            : QueueService.Tickets.Where(t => t.Department == selectedDept);

    private QueueTicket? CurrentServing => ActiveTickets.FirstOrDefault(t => t.Status == TicketStatus.NowServing);
    private List<QueueTicket> FilteredWaitingTickets => ActiveTickets.Where(t => t.Status == TicketStatus.Waiting).ToList();

    private int WaitingCount => QueueService.Tickets.Count(t => t.Status == TicketStatus.Waiting);
    private int ServingCount => QueueService.Tickets.Count(t => t.Status == TicketStatus.NowServing);
    private int CompletedCount => QueueService.History.Count(t => t.Status == TicketStatus.Completed);
    private int SkippedCount => QueueService.History.Count(t => t.Status == TicketStatus.Skipped);

    protected override void OnInitialized()
    {
        QueueService.OnChange += OnQueueUpdated;
    }

    private void OnQueueUpdated()
    {
        _ = InvokeAsync(() =>
        {
            if (!_isDisposed)
            {
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        _isDisposed = true;
        QueueService.OnChange -= OnQueueUpdated;
    }
}